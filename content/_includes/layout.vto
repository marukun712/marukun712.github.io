<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>{{ basename || "maril.blue" }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/styles/tokyo-night-dark.min.css" />
    <link rel="icon" href="https://avatars.githubusercontent.com/u/87289638?v=4" type="image/png" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
  </head>
  <body>
    <header>
      <a href="/">maril.blue</a>
    </header>
    <main>
      {{ if basename }}
        <h1>{{ basename }}</h1>
      {{ /if }}
      {{ content }}
      {{ if url == "/" }}
        <h1>Posts</h1>
        <ul class="list">
          {{ for page of search.pages("url^=/posts/", "basename=asc") }}
            <li><a href="{{ page.url }}">{{ page.basename }}</a></li>
          {{ /for }}
        </ul>
        <h1>Memo</h1>
        <ul class="list">
          {{ for page of search.pages("url^=/memo/", "basename=asc") }}
            <li><a href="{{ page.url }}">{{ page.basename }}</a></li>
          {{ /for }}
        </ul>
      {{ /if }}
    </main>
    <footer>maril.blue</footer>
  </body>
</html>
