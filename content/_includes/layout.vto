<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/styles/tokyo-night-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
  </head>
  <body>
    <header>
	    <h1>maril.blue</h1>
	    <p>marilの個人サイト</p>	 
    </header>
    <aside>
      <nav>
        <ul>
          {{ for page of search.pages() }}
            {{ if page.basename != "" }}
              <li><a href="{{ page.url }}">{{ page.basename }}</a></li>
            {{ /if }}
          {{ /for }}
        </ul>
      </nav>
    </aside>
    <main>
      {{ content }}
    </main>
  </body>
</html>
